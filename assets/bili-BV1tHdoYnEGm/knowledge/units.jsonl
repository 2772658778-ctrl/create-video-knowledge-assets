{"unit_id": "ku-core-question", "type": "question", "title": "为什么中国之外很少吃笋", "statement": "视频提出一个资源分布与消费习惯不一致的问题：竹子并非中国独有，但中国在竹笋消费和烹饪文化上的存在感远高于多数国家。", "evidence_refs": ["tr-000013", "tr-000014", "tr-000016", "tr-000017", "tr-000019", "ev-frame-regional-map"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["竹笋", "消费差异"], "schema_version": "1.0"}
{"unit_id": "ku-resource-vs-consumption", "type": "claim", "title": "竹林资源与消费集中并不相同", "statement": "视频给出的对比是：全球有超过两千两百万公顷土地生长竹子，中国占种植面积不到三分之一，但中国占世界竹笋消费约三分之二。", "evidence_refs": ["tr-000011", "tr-000013", "tr-000014", "tr-000016", "tr-000017"], "epistemic_status": "video_explicit", "importance": "high", "limitations": ["这里保留视频中的统计口径，不把它扩展为外部统计共识。"], "tags": ["资源", "消费"], "schema_version": "1.0"}
{"unit_id": "ku-growth-seasonality", "type": "mechanism", "title": "快速生长与春季窗口", "statement": "视频将竹笋描述为经历冬季蛰伏、春雨后破土，并在随后约十天里快速向上生长的季节性食材。", "evidence_refs": ["tr-000029", "tr-000030", "tr-000032", "tr-000035", "tr-000036", "tr-000037", "tr-000038"], "epistemic_status": "video_explicit", "importance": "medium", "tags": ["生长", "季节性"], "schema_version": "1.0"}
{"unit_id": "ku-flavor-nutrition", "type": "concept", "title": "鲜甜脆爽与营养吸引力", "statement": "视频把竹笋的吸引力归纳为糖类带来的甜味、氨基酸带来的鲜味、高含水量带来的脆爽口感，以及百分之一点二至百分之五点八的蛋白质含量和较均衡的氨基酸组成。", "evidence_refs": ["tr-000050", "tr-000053", "tr-000055", "tr-000056", "tr-000059", "tr-000060", "tr-000065", "tr-000071", "tr-000072", "tr-000073", "tr-000074", "ev-frame-flavor-protein"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["风味", "营养"], "schema_version": "1.0"}
{"unit_id": "ku-edible-varieties", "type": "limitation", "title": "不是所有竹笋都适合食用", "statement": "视频强调竹子品种很多，但可食用竹笋受到品种大小、采集效率、纤维硬度和苦味等条件限制，长期筛选后才形成常见的可食用品种。", "evidence_refs": ["tr-000087", "tr-000088", "tr-000089", "tr-000090", "tr-000093", "tr-000095", "tr-000096", "tr-000097", "tr-000098", "tr-000099", "tr-000100"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["品种", "可食用性"], "schema_version": "1.0"}
{"unit_id": "ku-light-bitterness", "type": "mechanism", "title": "产区与光照会改变苦涩", "statement": "视频将苦涩与产区生态条件联系起来，并进一步说明光照增强可能促进苦味和涩味相关物质积累，因此只挑品种而不挑产区，可能得到难以下咽的竹笋。", "evidence_refs": ["tr-000102", "tr-000103", "tr-000104", "tr-000105", "tr-000106", "tr-000107", "tr-000109", "tr-000110", "tr-000112", "tr-000113", "tr-000114", "tr-000119", "tr-000120"], "epistemic_status": "video_explicit", "importance": "high", "limitations": ["部分生化名词来自 base ASR 的保守修复，文章只保留视频能够支撑的机制方向。"], "tags": ["光照", "苦涩", "产区"], "schema_version": "1.0"}
{"unit_id": "ku-preservation-fermentation", "type": "procedure", "title": "用预处理把苦笋变成可保存食材", "statement": "视频展示的传统路径包括腌渍、发酵、煮熟和晒干：先降低苦涩并延长保存，再通过酸笋、笋干等形式进入地方饮食。", "evidence_refs": ["tr-000127", "tr-000128", "tr-000129", "tr-000130", "tr-000131", "tr-000132", "tr-000133", "tr-000135", "tr-000136", "tr-000137", "tr-000138", "tr-000139", "tr-000140", "ev-frame-edible-threshold"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["腌渍", "发酵", "保存"], "schema_version": "1.0"}
{"unit_id": "ku-oil-frying", "type": "mechanism", "title": "油炒放大竹笋风味", "statement": "视频把油炒视为中国竹笋烹饪的重要突破：相比蒸煮，油炒利用高温和油脂作用减少部分腥苦气，并增加醛酮类、吡嗪类等香气方向，形成更强的焦糖和熟香感。", "evidence_refs": ["tr-000166", "tr-000167", "tr-000170", "tr-000171", "tr-000172", "tr-000173", "tr-000174", "tr-000175", "tr-000176", "tr-000178", "tr-000183", "ev-frame-stir-fry"], "epistemic_status": "video_explicit", "importance": "high", "limitations": ["文章沿用视频的解释，不把未在视频中展开的化学细节补成外部结论。"], "tags": ["油炒", "香气", "烹饪"], "schema_version": "1.0"}
{"unit_id": "ku-meat-umami", "type": "mechanism", "title": "竹笋与肉类形成鲜味协同", "statement": "视频解释，肉类中的呈味物质与竹笋中的鲜味氨基酸结合，会形成更强的鲜味协同；多孔纤维结构又有利于吸收炖煮时释放的脂溶性香气。", "evidence_refs": ["tr-000184", "tr-000185", "tr-000186", "tr-000191", "tr-000192", "tr-000193", "tr-000194", "tr-000195", "tr-000196", "tr-000197", "tr-000198", "tr-000199"], "epistemic_status": "video_explicit", "importance": "medium", "tags": ["鲜味", "炖肉"], "schema_version": "1.0"}
{"unit_id": "ku-world-low-adoption", "type": "claim", "title": "食用门槛解释了地域差异", "statement": "视频的解释不是简单归因于竹子数量，而是强调可食用品种、产地气候、地方传统和处理方式共同构成食用门槛；这些条件在很多竹区并未同时出现。", "evidence_refs": ["tr-000201", "tr-000204", "tr-000205", "tr-000206", "tr-000207", "tr-000208", "tr-000209", "tr-000213", "tr-000215", "tr-000219", "tr-000223", "tr-000224", "tr-000228", "tr-000229", "tr-000230", "tr-000231", "tr-000240", "tr-000241", "tr-000242", "tr-000243", "tr-000244"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["地域", "传统", "门槛"], "schema_version": "1.0"}
{"unit_id": "ku-japan-case", "type": "example", "title": "日本用遮光追求白笋", "statement": "视频把日本作为中国之外的吃笋大户案例：温和湿润的海洋性气候、山地环境和遮光栽培共同指向更鲜甜、细嫩、少苦的白竹笋。", "evidence_refs": ["tr-000246", "tr-000247", "tr-000248", "tr-000249", "tr-000250", "tr-000251", "tr-000253", "tr-000254", "tr-000255", "tr-000256", "tr-000257", "tr-000258", "tr-000259", "tr-000260", "tr-000261", "tr-000262"], "epistemic_status": "video_explicit", "importance": "medium", "tags": ["日本", "遮光"], "schema_version": "1.0"}
{"unit_id": "ku-five-hour-window", "type": "mechanism", "title": "采后五小时是鲜度窗口", "statement": "视频提出竹笋采后约五小时的黄金加工窗口：若不及时处理，呼吸作用会伴随糖分和口感变化，使甜味下降、质地变粗；传统保存虽能延长时间，却难以完全复原鲜笋口感。", "evidence_refs": ["tr-000271", "tr-000272", "tr-000274", "tr-000275", "tr-000276", "tr-000277", "tr-000278", "tr-000279", "tr-000280", "tr-000281", "tr-000282", "tr-000283", "tr-000284", "tr-000285", "tr-000286", "tr-000287", "tr-000288", "tr-000289", "tr-000290"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["保鲜", "时间窗口"], "schema_version": "1.0"}
{"unit_id": "ku-modern-processing", "type": "procedure", "title": "现代加工把鲜笋送上全年餐桌", "statement": "视频展示的现代流程包括产地采收、五小时内送入工厂、过热蒸汽杀青、冰水快速冷却和零下四十五至六十五摄氏度的超低温冷冻，目标是降低苦涩并尽量保持鲜甜脆爽。", "evidence_refs": ["tr-000292", "tr-000294", "tr-000296", "tr-000297", "tr-000298", "tr-000303", "tr-000304", "tr-000305", "tr-000306", "tr-000307", "tr-000309", "tr-000310", "tr-000311", "tr-000312", "tr-000313", "tr-000314", "tr-000315", "tr-000316", "tr-000317", "tr-000318", "tr-000319", "tr-000320", "tr-000321", "tr-000322", "tr-000323", "tr-000324", "tr-000325", "tr-000326", "tr-000327", "tr-000328", "tr-000329", "tr-000330", "tr-000331", "ev-frame-wuyi-bamboo-forest", "ev-frame-factory-blanching"], "epistemic_status": "video_explicit", "importance": "high", "tags": ["加工", "冷冻", "产地"], "schema_version": "1.0"}
{"unit_id": "ku-supply-chain-thesis", "type": "takeaway", "title": "食笋文化是整条链路的结果", "statement": "基于视频证据可以归纳：一个地区能否形成稳定的食笋文化，取决于品种筛选、产区条件、去涩烹饪、保存技术和消费传统是否在同一条链路上接得起来。", "evidence_refs": ["tr-000087", "tr-000106", "tr-000127", "tr-000167", "tr-000206", "tr-000271", "tr-000310", "tr-000314", "ev-frame-regional-map", "ev-frame-factory-blanching"], "epistemic_status": "agent_inference", "importance": "high", "limitations": ["这是对视频叙事的结构化归纳，不是视频逐字提出的理论，也不代表外部研究共识。"], "tags": ["归纳", "供应链", "文化"], "schema_version": "1.0"}
{"unit_id": "ku-advertorial-boundary", "type": "limitation", "title": "视频后段包含品牌案例边界", "statement": "视频后段将福建产区和一家企业的加工流程作为现代吃笋案例；这些画面可以支持流程与环境的描述，但不能单凭视频证明企业宣传语、产品效果或市场表现。", "evidence_refs": ["tr-000291", "tr-000310", "tr-000311", "tr-000314", "tr-000325", "tr-000326", "tr-000330", "tr-000333", "ev-frame-wuyi-bamboo-forest", "ev-frame-factory-blanching"], "epistemic_status": "agent_inference", "importance": "high", "limitations": ["本文不把品牌段落改写成独立的商业背书，也不补充视频之外的企业或产品事实。"], "tags": ["限制", "品牌案例"], "schema_version": "1.0"}
