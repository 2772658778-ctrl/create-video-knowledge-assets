# Python and test caches
**/__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
/.pytest-tmp*
/.venv/
/build/
/dist/
/work/
/.cache/
/.tmp/
*.egg-info/

# Local acceptance, comparison, and agent rerun workspaces
/*acceptance-*
/.comparison-*/
/.rerun-subagents/

# Internal iteration material and comparison baselines are not part of the public package.
/docs/superpowers/
/baselines/

# Downloaded or generated media. Publish only explicitly reviewed demo assets.
*.mp4
*.mkv
*.webm
*.mov
*.avi
*.wav
*.mp3
*.m4a
*.flac
*.part

# Local run assets. A run produces transcripts, frames, and intermediate
# records that belong to the operator, not to the published skill. The repo
# ships the skill, its docs, and reviewed demos only.
/assets/bili-*/

# Local retrieval indexes and LaTeX build intermediates
*.sqlite
*.sqlite3
*.aux
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
*.xdv

# Public demos contain only the delivered HTML (self-contained, images inlined)
# and any PDF a run was explicitly asked for.
/demos/**/*.json
/demos/**/*.tex
/demos/**/run-report.md

# Credentials and local acquisition inputs
/bilibili.txt
cookies.txt
*.cookies.txt
cookie-*.txt
.env
.env.*

# PRD documents and PRD tooling. Kept local, not part of the public package.
/LectureMind_*_PRD.md
/LectureMind_*_PRD.pdf
/PRD.pdf
/prd-assets/
/tools/
